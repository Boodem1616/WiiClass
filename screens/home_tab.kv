#:import T theme

# Tarjeta de categoría: ficha con ícono, nombre y cantidad de clases.
<CategoryCard@TarjetaToque>:
    categoria_id: 0
    nombre: ""
    grupo: ""
    icono: "book-outline"
    n_clases: 0
    orientation: "vertical"
    size_hint: None, None
    size: dp(158), dp(138)
    padding: dp(14)
    spacing: dp(2)
    on_release: app.abrir_categoria(self.categoria_id, self.nombre)

    # Ficha circular con el ícono. AnchorLayout interno = centrado real
    # (los BoxLayout ignoran pos_hint en el eje principal).
    AnchorLayout:
        size_hint: None, None
        size: dp(46), dp(46)
        canvas.before:
            Color:
                rgba: T.MIST
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: root.icono
            size_hint: None, None
            size: dp(26), dp(26)
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: T.PRIMARY
            font_size: "24sp"

    Widget:

    TextoTitulo:
        text: root.nombre
        shorten: True
        shorten_from: "right"
        size_hint_y: None
        height: dp(22)

    TextoSuave:
        text: root.grupo + "  •  " + str(root.n_clases) + (" clase" if root.n_clases == 1 else " clases")
        size_hint_y: None
        height: dp(18)

# Fila de "Clases recientes".
<RecienteRow@TarjetaToque>:
    grabacion_id: 0
    titulo: ""
    detalle: ""
    icono: "book-outline"
    orientation: "horizontal"
    size_hint_y: None
    height: dp(68)
    padding: dp(12), dp(10)
    spacing: dp(12)
    on_release: app.abrir_reproductor(self.grabacion_id)

    AnchorLayout:
        size_hint: None, None
        size: dp(46), dp(46)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: T.PRIMARY
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: "play"
            size_hint: None, None
            size: dp(26), dp(26)
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_size: "24sp"

    BoxLayout:
        orientation: "vertical"

        TextoTitulo:
            text: root.titulo
            shorten: True
            shorten_from: "right"

        TextoSuave:
            text: root.detalle
            shorten: True
            shorten_from: "right"

<HomeTab>:
    name: "home_tab"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        # ---- Cabecera con degradado: saludo + iniciales del usuario ----
        CabeceraDegradada:
            id: header
            orientation: "horizontal"
            size_hint_y: None
            height: dp(124)
            padding: dp(20), dp(14), dp(20), dp(30)
            spacing: dp(12)

            BoxLayout:
                orientation: "vertical"
                spacing: dp(2)

                SubtituloCabecera:
                    id: saludo
                    text: "Hola"

                TituloCabecera:
                    id: nombre_usuario
                    text: ""

            AnchorLayout:
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"center_y": 0.5}
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.20
                    Ellipse:
                        pos: self.pos
                        size: self.size

                MDLabel:
                    id: iniciales
                    text: ""
                    halign: "center"
                    valign: "middle"
                    bold: True
                    font_style: "Title"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

        # ---- Contenido: hoja redondeada con categorías y recientes ----
        Hoja:
            orientation: "vertical"

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True
                bar_width: 0

                BoxLayout:
                    id: categorias_container
                    orientation: "vertical"
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(20), dp(20), dp(20), dp(24)
