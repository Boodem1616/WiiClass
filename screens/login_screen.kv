#:import dp kivy.metrics.dp
#:import T theme

<PillField@BoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(52)
    padding: dp(14), 0
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.24
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: 1, 1, 1, 0.4
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
            width: dp(1)

<PillIcon@AnchorLayout>:
    icon: "help"
    size_hint_x: None
    width: dp(24)
    anchor_x: "center"
    anchor_y: "center"

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 0.92, 0.94, 1, 1
        size_hint: None, None
        size: dp(24), dp(24)

<LoginScreen>:
    name: "login"

    FloatLayout:
        id: root_layout

        FloatLayout:
            id: notebook_layer
            size: root.size
            pos: root.pos

        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            # Ancho: 84% en pantallas angostas (celular), pero nunca más de
            # 420dp — en una ventana de escritorio ancha se ve como una
            # tarjeta centrada en vez de campos estirados de borde a borde.
            width: min(root.width * 0.84, dp(420))
            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: dp(6)

            # ---- Logo ----
            AnchorLayout:
                size_hint_y: None
                height: dp(104)
                anchor_x: "center"

                MDCard:
                    size_hint: None, None
                    size: dp(88), dp(88)
                    radius: [dp(24)]
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 1, 1, 1
                    style: "filled"

                    # MDCard es un BoxLayout: ignora pos_hint. Un AnchorLayout
                    # interno garantiza el centrado real del ícono.
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"

                        MDIcon:
                            icon: "microphone-outline"
                            size_hint: None, None
                            size: dp(64), dp(64)
                            halign: "center"
                            valign: "middle"
                            theme_text_color: "Custom"
                            text_color: T.PRIMARY
                            font_size: "60sp"

            MDLabel:
                text: "WiiClass"
                halign: "center"
                bold: True
                font_style: "Headline"
                role: "small"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_y: None
                height: dp(38)

            MDLabel:
                text: "Grabaciones de Clases"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0.8, 0.85, 0.97, 1
                font_style: "Body"
                role: "medium"
                size_hint_y: None
                height: dp(28)

            Widget:
                size_hint_y: None
                height: dp(10)

            # ---- Institución ----
            MDLabel:
                text: "Institución"
                theme_text_color: "Custom"
                text_color: 0.75, 0.8, 0.95, 1
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: dp(20)

            PillField:
                id: institucion_field
                on_touch_down: if self.collide_point(*args[1].pos): root.abrir_menu_instituciones(self)

                MDLabel:
                    id: institucion_label
                    text: root.institucion_seleccionada or "Selecciona tu institución"
                    theme_text_color: "Custom"
                    text_color: 0.92, 0.94, 1, 1
                    valign: "middle"
                    text_size: self.size

                PillIcon:
                    icon: "chevron-down"

            Widget:
                size_hint_y: None
                height: dp(6)

            # ---- Correo institucional ----
            MDLabel:
                text: "Correo Institucional"
                theme_text_color: "Custom"
                text_color: 0.75, 0.8, 0.95, 1
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: dp(20)

            PillField:
                PillIcon:
                    icon: "email-outline"

                TextInput:
                    id: correo
                    hint_text: "sflores@uct.cl"
                    hint_text_color: 0.65, 0.7, 0.88, 1
                    foreground_color: 0.92, 0.94, 1, 1
                    cursor_color: 1, 1, 1, 1
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    background_active: ""
                    multiline: False
                    padding: [0, (self.height - self.line_height) / 2]
                    font_size: "15sp"
                    # Enter en el correo salta a la contraseña.
                    write_tab: False
                    on_text_validate: password.focus = True

            Widget:
                size_hint_y: None
                height: dp(6)

            # ---- Contraseña ----
            MDLabel:
                text: "Contraseña"
                theme_text_color: "Custom"
                text_color: 0.75, 0.8, 0.95, 1
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: dp(20)

            PillField:
                PillIcon:
                    icon: "lock-outline"

                TextInput:
                    id: password
                    hint_text: "Contraseña"
                    hint_text_color: 0.65, 0.7, 0.88, 1
                    foreground_color: 0.92, 0.94, 1, 1
                    cursor_color: 1, 1, 1, 1
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    background_active: ""
                    multiline: False
                    password: True
                    padding: [0, (self.height - self.line_height) / 2]
                    font_size: "15sp"
                    # Enter en la contraseña inicia sesión.
                    on_text_validate: root.iniciar_sesion()

                MDIconButton:
                    id: toggle_password
                    icon: "eye-outline"
                    theme_text_color: "Custom"
                    text_color: 0.85, 0.88, 0.97, 1
                    on_release: root.toggle_password_visibility()

            Widget:
                size_hint_y: None
                height: dp(14)

            # ---- Botón de inicio de sesión ----
            MDButton:
                style: "filled"
                theme_bg_color: "Custom"
                md_bg_color: 1, 1, 1, 1
                size_hint: None, None
                theme_width: "Custom"
                # MDButton no respeta size_hint_x: 1; ancho explícito = ancho
                # del formulario para que el fondo blanco cubra todo el texto.
                width: self.parent.width if self.parent else dp(300)
                height: dp(50)
                radius: [dp(16)]
                pos_hint: {"center_x": 0.5}
                on_release: root.iniciar_sesion()

                MDButtonText:
                    text: "Iniciar Sesión"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: T.PRIMARY
                    size_hint_x: 1
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(10)

            MDButton:
                style: "text"
                pos_hint: {"center_x": 0.5}
                on_release: root.olvide_contrasena()

                MDButtonText:
                    text: "¿Olvidaste tu contraseña?"
                    theme_text_color: "Custom"
                    text_color: 0.85, 0.9, 1, 1
