#:import T theme

<NotificationsAllScreen>:
    name: "notifications_all"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        CabeceraDegradada:
            size_hint_y: None
            height: dp(64)
            padding: dp(8), 0, dp(8), 0
            spacing: dp(4)

            BotonCabecera:
                icon: "arrow-left"
                on_release: app.volver_de_todas_notificaciones()

            MDLabel:
                text: "Todas las notificaciones"
                bold: True
                font_style: "Title"
                role: "large"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.width, self.height

            BotonCabecera:
                icon: "delete-sweep-outline"
                on_release: root.confirmar_limpiar()

        Hoja:
            orientation: "vertical"

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                BoxLayout:
                    id: lista
                    orientation: "vertical"
                    spacing: dp(10)
                    padding: dp(20), dp(20), dp(20), dp(20)
                    size_hint_y: None
                    height: self.minimum_height
