#:import T theme

# Fila de una clase descargada.
<DownloadRow@TarjetaToque>:
    grabacion_id: 0
    ruta_local: ""
    titulo: ""
    fecha: ""
    peso_txt: ""
    orientation: "horizontal"
    size_hint_y: None
    height: dp(68)
    padding: dp(12), dp(10)
    spacing: dp(12)
    on_release: app.abrir_reproductor(self.grabacion_id, self.ruta_local)

    AnchorLayout:
        size_hint: None, None
        size: dp(46), dp(46)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: T.PRIMARY
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: "play"
            size_hint: None, None
            size: dp(26), dp(26)
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_size: "24sp"

    BoxLayout:
        orientation: "vertical"

        TextoTitulo:
            text: root.titulo
            shorten: True
            shorten_from: "right"

        TextoSuave:
            text: root.fecha + "   •   " + root.peso_txt if root.peso_txt else root.fecha

    MDIcon:
        icon: "check-circle"
        size_hint_x: None
        width: dp(28)
        theme_text_color: "Custom"
        text_color: T.SUCCESS

<DownloadsTab>:
    name: "downloads_tab"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        CabeceraDegradada:
            orientation: "vertical"
            size_hint_y: None
            height: dp(104)
            padding: dp(20), dp(14), dp(20), dp(30)
            spacing: dp(2)

            TituloCabecera:
                text: "Descargas"

            SubtituloCabecera:
                text: "Clases disponibles sin conexión"

        Hoja:
            orientation: "vertical"

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                BoxLayout:
                    id: contenedor
                    orientation: "vertical"
                    spacing: dp(12)
                    padding: dp(20), dp(20), dp(20), dp(24)
                    size_hint_y: None
                    height: self.minimum_height
