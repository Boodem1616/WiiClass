#:import T theme

# Chip de filtro por semana. Se dibuja a mano (relleno + borde) en vez de
# usar MDButton: cambiar `style` de un MDButton en caliente era poco fiable.
# El chip mide lo que mide su texto + 32dp de margen.
<WeekTab@ButtonBehavior+AnchorLayout>:
    valor: None
    activo: False
    texto: "Todas"
    size_hint: None, None
    size: label.texture_size[0] + dp(32), dp(36)
    canvas.before:
        Color:
            rgba: T.PRIMARY if self.activo else T.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: T.PRIMARY if self.activo else T.OUTLINE
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)
            width: dp(1)

    MDLabel:
        id: label
        text: root.texto
        size_hint: None, None
        size: self.texture_size
        halign: "center"
        bold: True
        font_style: "Label"
        role: "large"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.activo else T.PRIMARY

# Fila de una clase grabada (ver ClaseRow en category_screen.py).
<ClaseRow>:
    orientation: "horizontal"
    size_hint_x: 1
    size_hint_y: None
    height: dp(76)
    # Padding derecho grande: reserva el espacio del botón de descarga,
    # que va anclado a la derecha por ClaseRowSlot.
    padding: dp(12), dp(10), dp(58), dp(10)
    spacing: dp(12)
    canvas.before:
        # Borde: azul si está seleccionada, gris azulado si no.
        Color:
            rgba: T.PRIMARY if root.seleccionada else T.OUTLINE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        # Relleno: se tiñe al seleccionar o al presionar.
        Color:
            rgba: T.MIST if (root.seleccionada or self.state == "down") else T.SURFACE
        RoundedRectangle:
            pos: self.x + dp(1), self.y + dp(1)
            size: self.width - dp(2), self.height - dp(2)
            radius: [dp(15)]

    # Ficha circular: ▶ normalmente; ○/✓ en modo selección múltiple.
    AnchorLayout:
        size_hint: None, None
        size: dp(46), dp(46)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: T.PRIMARY if root.seleccionada else T.MIST
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: ("check" if root.seleccionada else "circle-outline") if root.modo_seleccion else "play"
            size_hint: None, None
            size: dp(26), dp(26)
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: T.SURFACE if root.seleccionada else T.PRIMARY
            font_size: "24sp"

    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        spacing: dp(2)

        TextoTitulo:
            text: root.titulo
            shorten: True
            shorten_from: "right"

        TextoSuave:
            text: root.fecha + "   •   " + root.duracion_txt

<CategoryScreen>:
    name: "category_screen"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        # ---- Cabecera única: cambia según el modo de selección ----
        # Normal:    [←]  Nombre de la categoría
        # Selección: [✕]  N seleccionada(s)                [⬇ descargar]
        # (Antes eran dos barras distintas que se intercambiaban
        # poniendo la altura de una en 0; ahora es una sola.)
        CabeceraDegradada:
            id: header
            size_hint_y: None
            height: dp(64)
            padding: dp(8), 0, dp(8), 0
            spacing: dp(4)

            BotonCabecera:
                icon: "close" if root.modo_seleccion else "arrow-left"
                on_release: root.atras()

            MDLabel:
                text: (str(root.num_seleccionadas) + " seleccionada(s)") if root.modo_seleccion else root.titulo_categoria
                bold: True
                font_style: "Title"
                role: "large"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.width, self.height

            BotonCabecera:
                icon: "download-outline"
                opacity: 1 if root.modo_seleccion else 0
                disabled: not root.modo_seleccion
                on_release: root.descargar_seleccionadas()

        Hoja:
            orientation: "vertical"
            padding: 0, dp(16), 0, 0
            spacing: dp(6)

            # ---- Pestañas de semana ----
            ScrollView:
                do_scroll_y: False
                bar_width: 0
                size_hint_y: None
                height: dp(46)

                BoxLayout:
                    id: semanas_row
                    orientation: "horizontal"
                    spacing: dp(8)
                    padding: dp(20), dp(4)
                    size_hint_x: None
                    width: self.minimum_width

            # ---- Lista de clases ----
            ScrollView:
                do_scroll_x: False
                bar_width: 0

                BoxLayout:
                    id: lista_clases
                    orientation: "vertical"
                    spacing: dp(10)
                    padding: dp(20), dp(8), dp(20), dp(20)
                    size_hint_y: None
                    height: self.minimum_height
