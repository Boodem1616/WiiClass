#:import T theme

# Renglón de datos del perfil: etiqueta pequeña arriba, valor abajo.
<ProfileField@MDBoxLayout>:
    label: ""
    value: ""
    orientation: "vertical"
    size_hint_y: None
    height: dp(60)
    padding: dp(4), dp(6)

    TextoSuave:
        text: root.label
        size_hint_y: None
        height: dp(18)

    TextoTitulo:
        text: root.value

<ProfileTab>:
    name: "profile_tab"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        # ---- Cabecera con avatar ----
        CabeceraDegradada:
            orientation: "vertical"
            size_hint_y: None
            height: dp(214)
            padding: dp(20), dp(16), dp(20), dp(34)
            spacing: dp(6)

            # Avatar circular. Se dibuja con Ellipse: el `radius: [48, ...]`
            # que tenía antes estaba en píxeles, no en dp, y en un teléfono
            # de pantalla densa (2-3x) el círculo salía como cuadrado
            # apenas redondeado.
            AnchorLayout:
                size_hint: None, None
                size: dp(88), dp(88)
                pos_hint: {"center_x": 0.5}
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size

                MDLabel:
                    id: iniciales
                    text: ""
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    bold: True
                    font_style: "Headline"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: T.PRIMARY

            TituloCabecera:
                id: nombre_lbl
                text: ""
                halign: "center"

            SubtituloCabecera:
                id: rol_lbl
                text: "Estudiante de Pregrado"
                halign: "center"

        Hoja:
            orientation: "vertical"
            padding: dp(20), dp(20), dp(20), dp(20)
            spacing: dp(16)

            Tarjeta:
                orientation: "vertical"
                size_hint_y: None
                height: dp(212)
                padding: dp(12)

                ProfileField:
                    id: campo_nombre
                    label: "Nombre completo"

                ProfileField:
                    id: campo_fecha
                    label: "Fecha de nacimiento"

                ProfileField:
                    id: campo_institucion
                    label: "Institución"

            Widget:

            MDButton:
                style: "outlined"
                pos_hint: {"center_x": 0.5}
                line_color: T.DANGER
                on_release: app.cerrar_sesion()

                MDButtonIcon:
                    icon: "logout"
                    theme_icon_color: "Custom"
                    icon_color: T.DANGER

                MDButtonText:
                    text: "Cerrar sesión"
                    theme_text_color: "Custom"
                    text_color: T.DANGER
