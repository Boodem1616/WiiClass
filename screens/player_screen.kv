#:import T theme

# Chip de velocidad (0.5x / 1.0x / 1.5x / 2.0x). Mismo estilo que los
# chips de semana; aquí ocupa partes iguales del ancho de la fila.
<SpeedButton@ButtonBehavior+AnchorLayout>:
    value: 1.0
    active: False
    texto: "1.0x"
    canvas.before:
        Color:
            rgba: T.PRIMARY if self.active else T.SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(19)]
        Color:
            rgba: T.PRIMARY if self.active else T.OUTLINE
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(19)
            width: dp(1)

    MDLabel:
        text: root.texto
        halign: "center"
        valign: "middle"
        text_size: self.size
        bold: True
        font_style: "Label"
        role: "large"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.active else T.PRIMARY

<PlayerScreen>:
    name: "player_screen"
    md_bg_color: T.BG

    BoxLayout:
        orientation: "vertical"

        # ---- Cabecera ----
        CabeceraDegradada:
            id: header
            size_hint_y: None
            height: dp(64)
            padding: dp(8), 0, dp(8), 0
            spacing: dp(4)

            BotonCabecera:
                icon: "arrow-left"
                on_release: app.volver_desde_reproductor()

            MDLabel:
                text: "Reproduciendo"
                bold: True
                font_style: "Title"
                role: "large"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.width, self.height

        Hoja:
            orientation: "vertical"
            padding: dp(20), dp(20), dp(20), dp(16)
            spacing: dp(10)

            # ---- Portada: ficha de categoría + onda + título ----
            # Es el elemento protagonista de la pantalla; el resto es sobrio.
            BoxLayout:
                id: cover
                orientation: "vertical"
                size_hint_y: None
                height: dp(250)
                padding: dp(18)
                spacing: dp(4)
                canvas.before:
                    Color:
                        rgba: T.BLUE
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(26)]

                AnchorLayout:
                    anchor_x: "left"
                    anchor_y: "top"
                    size_hint_y: None
                    height: dp(46)

                    AnchorLayout:
                        size_hint: None, None
                        size: dp(46), dp(46)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 0.22
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]

                        MDIcon:
                            id: icono_categoria
                            icon: "book-outline"
                            size_hint: None, None
                            size: dp(26), dp(26)
                            halign: "center"
                            valign: "middle"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            font_size: "24sp"

                Widget:

                # Forma de onda: las barras se iluminan según el progreso.
                Waveform:
                    id: onda
                    size_hint_y: None
                    height: dp(70)

                MDLabel:
                    id: titulo_clase
                    text: ""
                    bold: True
                    shorten: True
                    shorten_from: "right"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    font_style: "Title"
                    role: "medium"
                    size_hint_y: None
                    height: dp(30)

                MDLabel:
                    id: subtitulo_clase
                    text: ""
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.82
                    font_style: "Body"
                    role: "medium"
                    size_hint_y: None
                    height: dp(20)

            # ---- Barra de progreso (para buscar dentro de la clase) ----
            MDSlider:
                id: slider
                min: 0
                max: 100
                value: 0
                size_hint_y: None
                height: dp(28)
                track_active_color: T.PRIMARY
                track_inactive_color: T.OUTLINE
                on_touch_down: root.on_slider_press(*args)
                on_touch_up: root.on_slider_release(*args)

                MDSliderHandle:
                    theme_bg_color: "Custom"
                    md_bg_color: T.PRIMARY

            BoxLayout:
                size_hint_y: None
                height: dp(20)
                padding: dp(4), 0

                TextoSuave:
                    id: lbl_pos
                    text: "00:00"

                Widget:

                TextoSuave:
                    id: lbl_dur
                    text: "00:00"
                    halign: "right"

            # ---- Controles: anterior · -10s · PLAY · +10s · siguiente ----
            BoxLayout:
                size_hint_y: None
                height: dp(72)
                spacing: dp(6)

                Widget:

                BotonPlano:
                    icon: "skip-previous"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.saltar_anterior()

                BotonPlano:
                    icon: "rewind-10"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.retroceder_10()

                MDIconButton:
                    id: btn_play
                    icon: "play"
                    style: "filled"
                    theme_bg_color: "Custom"
                    md_bg_color: T.PRIMARY
                    theme_icon_color: "Custom"
                    icon_color: 1, 1, 1, 1
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    theme_font_size: "Custom"
                    font_size: "34sp"
                    size_hint: None, None
                    size: dp(68), dp(68)
                    pos_hint: {"center_y": 0.5}
                    on_release: root.toggle_play()

                BotonPlano:
                    icon: "fast-forward-10"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.adelantar_10()

                BotonPlano:
                    icon: "skip-next"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.saltar_siguiente()

                Widget:

            # ---- Velocidad ----
            BoxLayout:
                id: speed_row
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)
                padding: dp(4), 0

            Widget:
                # Espaciador flexible: absorbe el espacio sobrante al FINAL
                # de la columna, para que la portada quede pegada arriba.
